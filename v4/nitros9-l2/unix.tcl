# unix.tcl -- Unix-style commands for NitrOS-9 Level 2 on the TFR/911H.
# Sourced by rmake-l2.tcl.
#
#   * cd and exit become Shell built-ins, by patching a copy of shell_21.asm.
#   * pwd and pxd come from NitrOS-9's pd.asm (see UNIX_CMDS).
#   * Each alias below becomes a tiny command that F$Chains to the real
#     OS-9 command, putting any extra arguments in front of yours.
#   * clear and the rest of UNIX_CMDS are ordinary commands (see modules/).

# name  OS-9 command  extra arguments  what "-l" as the first argument becomes
set UNIX_ALIASES {
    ls      dir      {}         -e
    ll      dir      -e         {}
    cat     list     {}         {}
    cp      copy     {}         {}
    mv      rename   {}         {}
    rm      del      {}         {}
    mkdir   makdir   {}         {}
    rmdir   deldir   {}         {}
    ps      procs    {}         {}
    df      free     {}         {}
    less    more     {}         {}
    man     help     {}         {}
    uname   echo     {NitrOS-9 Level 2 on the TFR/911H} {}
    vim     vi       {}         {}
}

# Real commands, in rmake's "-cmds" syntax.
set UNIX_CMDS {
    pwd=pd,PWD=1
    pxd=pd,PXD=1
    clear
    beep click
}

# Generated sources go here.  FindViaUsing looks here after ./modules.
set LocalBuild [file normalize build/local]
file mkdir $LocalBuild

proc GenerateAlias {name target prefix lopt} {
    set w [open $::LocalBuild/$name.asm w]
    puts $w "* $name -- Unix-style alias for \"[string trim "$target $prefix"]\"."
    puts $w "* Generated by unix.tcl.  F\$Chains to $target with the parameters"
    puts $w "* given, after the extra ones[expr {$lopt ne {} ? ", and with a leading -l changed to $lopt" : {}}]."
    puts $w {
                    nam       NAME
                    ttl       Unix-style alias

                    ifp1
                    use       defsfile
                    endc

tylg                set       Prgrm+Objct
atrv                set       ReEnt+rev
rev                 set       $00

                    mod       eom,name,tylg,atrv,start,size

                    org       0
                    rmb       256                 stack
buf                 rmb       512                 the new parameter line
size                equ       .

name                fcs       /NAME/
                    fcb       1                   edition

target              fcc       /TARGET/
                    fcb       C$CR
prefix              equ       *}
    if {$prefix ne ""} {
        puts $w "                    fcc       |$prefix |"
    }
    puts $w {prefixe             equ       *
lopt                equ       *}
    if {$lopt ne ""} {
        puts $w "                    fcc       |$lopt|"
    }
    puts $w {lopte               equ       *

* Entry: X = parameters (ending in CR), U = data area.
* Keep the stack in the first page, as the Shell does before F$Chain:
* the new process inherits our SP, and if the new program's data area is
* only a page, F$Chain fails with E$DelSP (#223) when shrinking ours.
start               leas      255,u
                    leay      buf,u
                    ifne      lopte-lopt
                    ldd       ,x                  first parameter "-l"?
                    cmpd      #$2D6C
                    bne       nolopt
                    lda       2,x
                    cmpa      #C$SPAC
                    beq       islopt
                    cmpa      #C$CR
                    bne       nolopt
islopt              leax      2,x                 drop the "-l"
                    pshs      x
                    leax      lopt,pcr            and copy its replacement
                    ldb       #lopte-lopt
                    bra       copyp
nolopt              equ       *
                    endc
                    pshs      x
                    leax      prefix,pcr          copy the extra parameters
                    ldb       #prefixe-prefix
copyp               beq       copy2
copy1               lda       ,x+
                    sta       ,y+
                    decb
                    bne       copy1
copy2               puls      x                   then the given ones
copy3               lda       ,x+
                    sta       ,y+
                    cmpa      #C$CR
                    bne       copy3
                    leau      buf,u
                    tfr       y,d
                    pshs      u
                    subd      ,s++                D = size of the new parameters
                    tfr       d,y                 Y = that, U = buf
                    leax      target,pcr
                    lda       #Prgrm+Objct
                    clrb                          its own default data size
                    os9       F$Chain
                    os9       F$Exit              only if F$Chain failed

                    emod
eom                 equ       *
                    end}
    close $w
    # Fill in the names (done after writing, to keep the template readable).
    set f [open $::LocalBuild/$name.asm r]
    set text [read $f]
    close $f
    set text [string map [list /NAME/ /$name/ "nam       NAME" "nam       $name" /TARGET/ /$target/] $text]
    set f [open $::LocalBuild/$name.asm w]
    puts -nonewline $f $text
    close $f
}

# Add CD (same as CHD) and EXIT to the Shell's table of built-in commands.
proc PatchShell {} {
    set f [open $::N9Root/level1/cmds/shell_21.asm r]
    set text [read $f]
    close $f
    set chd " fdb Chd-*\n fcs \"CHD\"\n"
    if {[string first $chd $text] < 0} {
        error "PatchShell: cannot find the CHD entry in shell_21.asm"
    }
    set text [string map [list $chd "$chd fdb Chd-*\n fcs \"CD\"\n fdb shel90-*\n fcs \"EXIT\"\n"] $text]
    set w [open $::LocalBuild/shell_21.asm w]
    puts $w "* Generated by unix.tcl from NitrOS-9's level1/cmds/shell_21.asm,"
    puts $w "* adding built-in commands CD (same as CHD) and EXIT."
    puts -nonewline $w $text
    close $w
}

# NitrOS-9's grep wants the pattern in double quotes, and exits with a bogus
# error at end of file (alib's FGETS_NOCR loses the error code).  Allow an
# unquoted pattern, and call FGETS instead, removing the CR ourselves.
proc PatchGrep {} {
    set f [open $::N9Root/level1/cmds/grep.as r]
    set text [read $f]
    close $f
    set edits [list \
"                    beq       GetStr              yep, go to pattern handler
                    bra       Done                else wrong usage, we're done
" \
"                    beq       GetStr              yep, go to pattern handler
                    leax      -1,x                else an unquoted pattern
                    leay      <pattern,u          point to pattern buffer
                    clr       <pattlen            and clear the size variable
Word                lda       ,x+                 get char
                    cmpa      #C\$SPAC             a space ends it
                    beq       ChckFile
                    cmpa      #C\$CR               so does a CR
                    beq       WordEnd
                    ora       <maskbyte           else mask char
                    sta       ,y+                 and save it in buffer
                    inc       <pattlen            increment the size by one
                    bra       Word                and get the next char
WordEnd             leax      -1,x                leave X on the CR: read StdIn
                    bra       ChckFile
" \
"                    lbsr      FGETS_NOCR
                    bcs       EOF                 if error, check for EOF
" \
"                    lbsr      FGETS               (FGETS_NOCR loses the error code)
                    bcs       EOF                 if error, check for EOF
                    pshs      x,y
                    tfr       y,d
                    leax      -1,x
                    clr       d,x                 replace the CR with a null
                    puls      x,y
"]
    foreach {from to} $edits {
        if {[string first $from $text] < 0} {
            error "PatchGrep: grep.as is not as expected"
        }
        set text [string map [list $from $to] $text]
    }
    set w [open $::LocalBuild/grep.as w]
    puts $w "* Generated by unix.tcl from NitrOS-9's level1/cmds/grep.as:"
    puts $w "* accepts an unquoted pattern, and exits cleanly at end of file."
    puts -nonewline $w $text
    close $w
}

PatchShell
PatchGrep
foreach {name target prefix lopt} $UNIX_ALIASES {
    GenerateAlias $name $target $prefix $lopt
    lappend UNIX_CMDS $name
}
